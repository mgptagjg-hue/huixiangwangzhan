{
  "name": "huixiang-auto-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/validate-site-origin.mjs",
    "dev": "set ASTRO_TELEMETRY_DISABLED=1&& astro dev",
