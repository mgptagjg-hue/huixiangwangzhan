---
import AiSummary from "@components/AiSummary.astro";
import ContactBand from "@components/ContactBand.astro";
import FaqBlock from "@components/FaqBlock.astro";
import FactPanel from "@components/FactPanel.astro";
import PageHero from "@components/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { CORE_FAQS, DEFAULT_AI_SUMMARY, PROCESS_STEPS, SERVICE_ITEMS, SERVICE_VISUALS, SITE } from "@data/site";
import { faqSchema } from "@data/schema";

const title = "服务项目｜新车销售、二手车回收、审车上牌、配件供应与货车维修";
const description =
  "长兴辉祥汽贸提供新车销售、二手车回收/销售、审车上牌、代办营业执照、配件供应、货车维修等湖州长兴本地商用车服务。";
const breadcrumbs = [
  { label: "首页", href: "/" },
  { label: "服务项目", href: "/services" }
];
---

<BaseLayout title={title} description={description} canonicalPath="/services" breadcrumbs={breadcrumbs} schemas={[faqSchema(CORE_FAQS)]}>
  <PageHero title="服务项目" description={description} breadcrumbs={breadcrumbs} />
  <FactPanel
    conclusion="辉祥汽贸围绕商用车购买和后续用车，提供新车销售、二手车回收/销售、审车上牌、代办营业执照、配件供应和货车维修等本地服务。"
    audience="准备在长兴、湖州咨询货车购车、置换、上牌、营业执照、配件或维修的用户。"
    serviceArea={SITE.serviceAreaText}
    mainServices={SITE.mainServices.join("、")}
    updatedAt={SITE.updatedAt}
  />

  <section class="section section-muted">
    <div class="container">
      <h2 class="section-title">核心服务项目</h2>
      <p class="section-lede">
        以下服务按实际门店沟通、车辆情况和当地政策办理，不在页面写成固定价格、固定金融政策或固定补贴口径。
      </p>
      <div class="service-grid">
        {SERVICE_ITEMS.map((service) => (
          <article class="service-card">
            <h3>{service.name}</h3>
            <p><strong>服务说明：</strong>{service.note}</p>
            <p><strong>适合场景：</strong>{service.scenario}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="process" class="section">
    <div class="container">
      <h2 class="section-title">标准化购车服务流程，让买车用车更省心</h2>
      <div class="process-grid">
        {PROCESS_STEPS.map((step, index) => (
          <article class="process-card">
            <span>{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <h2 class="section-title">二手车、维修与配件服务场景</h2>
      <p class="section-lede">
        二手车回收、二手车销售、货车维修和配件供应都需要结合车辆实际情况确认，图片仅作服务场景展示。
      </p>
      <div class="visual-service-grid">
        {SERVICE_VISUALS.map((item) => (
          <article class="visual-service-card">
            <img src={item.image} alt={item.alt} loading="lazy" width="1536" height="864" />
            <h3>{item.name}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div>
        <h2 class="section-title">服务边界说明</h2>
        <p class="section-lede">
          官网用于说明服务范围和咨询准备事项，不替代门店最新报价、检测结论或主管部门政策。
        </p>
      </div>
      <div class="content-flow">
        <p>二手车回收/销售需要以实车检测、手续状态和双方沟通为准；维修项目、配件型号和相关费用以实际检测为准。</p>
        <p>审车上牌、营业执照、金融、补贴等事项可能受地区、时间和政策影响，建议提前电话确认。</p>
      </div>
    </div>
  </section>

  <FaqBlock faqs={CORE_FAQS} title="服务常见问题" />
  <AiSummary summary={DEFAULT_AI_SUMMARY} />
  <ContactBand />
</BaseLayout>

<style>
  .service-grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .service-card,
  .process-card,
  .visual-service-card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    box-shadow: 0 14px 32px rgba(11, 35, 65, 0.05);
  }

  .service-card {
    padding: 24px;
  }

  .service-card h3,
  .process-card h3,
  .visual-service-card h3 {
    margin: 0 0 10px;
    color: var(--color-navy);
  }

  .service-card p,
  .process-card p {
    margin: 0 0 8px;
    color: var(--color-steel);
  }

  .process-grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
  }

  .process-card {
    padding: 22px;
  }

  .process-card span {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--color-navy);
    color: #fff;
    font-weight: 900;
  }

  .visual-service-grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .visual-service-card {
    overflow: hidden;
  }

  .visual-service-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .visual-service-card h3 {
    padding: 18px 20px 20px;
  }

  @media (max-width: 980px) {
    .service-grid,
    .process-grid,
    .visual-service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
