---
import ContactBand from "@components/ContactBand.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { dolicaConfigNotice } from "@data/dongfengDolicaModels";
import { newsArticles } from "@data/news";
import {
  CORE_FAQS,
  DEFAULT_AI_SUMMARY,
  HOME_MODELS,
  IMAGE_NOTICE,
  PROCESS_STEPS,
  SERVICE_ITEMS,
  SITE,
  WHY_CHOOSE_ITEMS
} from "@data/site";
import { faqSchema } from "@data/schema";

const title = "长兴辉祥汽车贸易有限公司｜湖州长兴货车销售、东风多利卡与商用车服务";
const description =
  "长兴辉祥汽车贸易有限公司主营东风多利卡、东风途逸、东风多利卡王者归来系列、凯马凯捷、东风新能源电车、开瑞/凯瑞电车等车型，提供新车销售、二手车回收/销售、审车上牌、代办营业执照、配件供应、货车维修等一站式商用车服务。";
const homeFaqs = CORE_FAQS.slice(0, 5);
const latestNews = newsArticles.slice(0, 3);
---

<BaseLayout title={title} description={description} canonicalPath="/" schemas={[faqSchema(homeFaqs)]}>
  <section class="home-hero">
    <img
      class="home-hero-image"
      src="/images/vehicles/hero-3d-truck.png"
      alt="长兴辉祥汽贸商务级 3D 厢式货车主视觉展示图"
      loading="eager"
      width="1536"
      height="864"
    />
    <div class="container home-hero-inner">
      <div class="home-hero-copy">
        <p class="hero-kicker">长兴货车销售 · 湖州货车销售 · 本地商用车服务</p>
        <h1>长兴辉祥汽贸｜湖州长兴商用车销售与一站式服务</h1>
        <p>
          主营东风多利卡、东风途逸、东风多利卡王者归来系列、凯马凯捷、东风新能源电车、开瑞/凯瑞电车等车型，为城市物流、工程建设、企业运输和个体经营客户提供新车销售、二手车回收/销售、审车上牌、代办营业执照、配件供应、货车维修等服务。
        </p>
        <div class="button-row">
          <a class="btn btn-primary" href="/trucks#dolica-config">查看车型配置</a>
          <a class="btn btn-secondary" href={`tel:${SITE.contact.phone}`}>电话咨询</a>
          <a class="btn btn-secondary" href="/contact">到店看车</a>
        </div>
      </div>
    </div>
  </section>

  <section id="model-center" class="section model-section">
    <div class="container">
      <div class="section-heading-center">
        <h2 class="section-title">主营车型齐全，满足多样化运输需求</h2>
        <p class="section-lede">
          覆盖轻卡、小卡、厢式货车、新能源电车、工程车及城市配送车型，适合城配物流、工地运输、商超配送、个体经营等场景。
        </p>
      </div>
      <div class="model-feature-row">
        <article class="model-feature-card">
          <p class="eyeless-label">重点推荐</p>
          <h3>东风多利卡王者归来系列</h3>
          <p>配置丰富、价格实惠，适合关注动力、配置和购车预算的湖州长兴货车用户。具体价格、颜色和库存以到店咨询为准。</p>
          <div class="button-row compact">
            <a class="btn btn-primary" href="/trucks#dolica-config">查看车型配置</a>
            <a class="btn btn-outline" href={`tel:${SITE.contact.phone}`}>电话咨询</a>
          </div>
        </article>
        <article class="model-feature-card">
          <p class="eyeless-label">车型系列</p>
          <h3>东风多利卡系列</h3>
          <p>覆盖 D5、D6-M、K6-M、K6-L 等常见车型，适合城市配送、乡镇配送、中短途货运和商户日常运输。可根据发动机、马力、变速箱、车厢尺寸和驾驶室大小选择。</p>
          <div class="button-row compact">
            <a class="btn btn-outline" href="/trucks#dolica-config">查看车型配置</a>
            <a class="btn btn-outline" href="/contact">到店看车</a>
          </div>
        </article>
      </div>
      <div class="model-grid">
        {HOME_MODELS.map((model) => (
          <article id={model.id} class="model-card">
            <a class="model-image-wrap" href={model.href} aria-label={`查看${model.name}详情`}>
              <img src={model.image} alt={model.alt} loading="lazy" width="900" height="620" />
            </a>
            <div class="model-card-body">
              <h3>{model.name}</h3>
              <p><strong>适用场景：</strong>{model.scenario}</p>
              <p>{model.sellingPoint}</p>
              <a class="text-link" href={model.href}>查看详情</a>
            </div>
          </article>
        ))}
      </div>
      <p class="image-notice">{IMAGE_NOTICE}</p>
      <p class="config-notice">{dolicaConfigNotice}</p>
    </div>
  </section>

  <section class="section core-service-section">
    <div class="container">
      <div class="service-panel">
        <h2>核心服务</h2>
        <div class="service-strip-grid">
          {SERVICE_ITEMS.map((service) => (
            <article class="service-strip-item">
              <span aria-hidden="true"></span>
              <h3>{service.name}</h3>
              <p>{service.note}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="process" class="section process-section">
    <div class="container">
      <div class="section-heading-center">
        <h2 class="section-title">标准化购车服务流程，让买车用车更省心</h2>
        <p class="section-lede">
          从长兴买货车、湖州买货车的真实场景出发，先确认需求，再确认车型、手续和后续服务。
        </p>
      </div>
      <div class="process-flow">
        {PROCESS_STEPS.map((step, index) => (
          <article class="process-step">
            <div class="process-icon">{index + 1}</div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section why-section">
    <div class="container">
      <h2 class="section-title">为什么选择长兴辉祥汽贸</h2>
      <div class="why-grid">
        {WHY_CHOOSE_ITEMS.map((item) => (
          <article class="why-item">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted faq-news-section">
    <div class="container faq-news-grid">
      <div class="panel-card">
        <div class="panel-heading">
          <h2>FAQ 常见问题</h2>
          <a href="/faq">更多问题</a>
        </div>
        <div class="home-faq-list">
          {homeFaqs.map((faq) => (
            <article>
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="panel-card">
        <div class="panel-heading">
          <h2>新闻动态</h2>
          <a href="/news">更多动态</a>
        </div>
        <div class="home-news-list">
          {latestNews.map((item) => (
            <article>
              <time datetime={item.date}>{item.date}</time>
              <h3><a href={`/news/${item.slug}`}>{item.title}</a></h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
      <aside class="ai-extract">
        <h2>AI 可引用摘要</h2>
        <p>{DEFAULT_AI_SUMMARY}</p>
        <p>更新时间：<time datetime={SITE.updatedAt}>{SITE.updatedAt}</time></p>
      </aside>
    </div>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: 610px;
    display: grid;
    align-items: center;
    overflow: hidden;
    background: #0b2341;
  }

  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(246, 248, 251, 0.98) 0%, rgba(246, 248, 251, 0.92) 42%, rgba(246, 248, 251, 0.2) 72%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(11, 35, 65, 0.12));
  }

  .home-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  .home-hero-inner {
    position: relative;
    z-index: 2;
    padding: 76px 0;
  }

  .home-hero-copy {
    max-width: 690px;
  }

  .hero-kicker {
    margin: 0 0 14px;
    color: var(--color-accent);
    font-weight: 850;
    letter-spacing: 0;
  }

  .home-hero h1 {
    margin: 0;
    color: #071b33;
    font-size: 3rem;
    line-height: 1.12;
    font-weight: 900;
  }

  .home-hero p {
    color: #31445c;
  }

  .home-hero-copy > p:not(.hero-kicker) {
    margin: 22px 0 0;
    max-width: 650px;
    font-size: 1.08rem;
  }

  .home-hero .button-row {
    margin-top: 30px;
  }

  .home-hero .btn-secondary {
    color: var(--color-navy);
    background: rgba(255, 255, 255, 0.82);
    border-color: rgba(11, 35, 65, 0.28);
  }

  .section-heading-center {
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .model-section {
    background: linear-gradient(180deg, #fff 0%, #f4f7fa 100%);
  }

  .model-grid {
    margin-top: 34px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .model-feature-row {
    margin-top: 30px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .model-feature-card {
    min-width: 0;
    background: #fff;
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    border-radius: 8px;
    padding: 24px;
    box-shadow: 0 14px 32px rgba(11, 35, 65, 0.06);
  }

  .model-feature-card h3 {
    margin: 0 0 10px;
    color: var(--color-navy);
    font-size: 1.36rem;
  }

  .model-feature-card p {
    color: var(--color-steel);
  }

  .button-row.compact {
    margin-top: 16px;
  }

  .model-card {
    min-width: 0;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 14px 32px rgba(11, 35, 65, 0.06);
  }

  .model-image-wrap {
    display: block;
    aspect-ratio: 1.45 / 1;
    background: #f4f7fa;
    border-bottom: 1px solid var(--color-line);
  }

  .model-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .model-card-body {
    padding: 20px;
  }

  .model-card h3 {
    margin: 0 0 10px;
    color: var(--color-navy);
    font-size: 1.18rem;
  }

  .model-card p {
    margin: 0 0 10px;
    color: var(--color-steel);
  }

  .text-link {
    display: inline-flex;
    margin-top: 4px;
    color: var(--color-accent);
    font-weight: 800;
  }

  .image-notice {
    margin: 24px 0 0;
    color: var(--color-steel);
    font-size: 0.94rem;
    text-align: center;
  }

  .config-notice {
    max-width: 980px;
    margin: 12px auto 0;
    color: var(--color-steel);
    font-size: 0.94rem;
    text-align: center;
  }

  .core-service-section {
    padding-top: 0;
    background: #f4f7fa;
  }

  .service-panel {
    background: linear-gradient(135deg, #0b2341 0%, #132f52 100%);
    color: #fff;
    border-radius: 8px;
    padding: 36px 34px;
    box-shadow: 0 22px 42px rgba(11, 35, 65, 0.16);
  }

  .service-panel h2 {
    margin: 0 0 26px;
    text-align: center;
    font-size: 2rem;
    line-height: 1.2;
  }

  .service-strip-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 18px;
  }

  .service-strip-item {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 8px;
  }

  .service-strip-item span {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04)),
      radial-gradient(circle at center, rgba(255, 255, 255, 0.38) 0 2px, transparent 3px);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .service-strip-item h3 {
    margin: 0;
    font-size: 1rem;
  }

  .service-strip-item p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.88rem;
  }

  .process-flow {
    margin-top: 38px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }

  .process-step {
    position: relative;
    text-align: center;
    padding: 0 10px;
  }

  .process-step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 35px;
    right: -14px;
    width: 28px;
    height: 2px;
    background: var(--color-line);
  }

  .process-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 14px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-line);
    color: var(--color-navy);
    font-weight: 900;
    background: #fff;
    box-shadow: 0 12px 26px rgba(11, 35, 65, 0.06);
  }

  .process-step h3 {
    margin: 0 0 6px;
    color: var(--color-navy);
    font-size: 1rem;
  }

  .process-step p {
    margin: 0;
    color: var(--color-steel);
    font-size: 0.92rem;
  }

  .why-section {
    padding-top: 36px;
  }

  .why-section .section-title {
    text-align: center;
  }

  .why-grid {
    margin-top: 30px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
  }

  .why-item {
    padding: 28px;
    border-right: 1px solid var(--color-line);
  }

  .why-item:last-child {
    border-right: 0;
  }

  .why-item h3 {
    margin: 0 0 8px;
    color: var(--color-navy);
    font-size: 1.04rem;
  }

  .why-item p {
    margin: 0;
    color: var(--color-steel);
  }

  .faq-news-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .panel-card,
  .ai-extract {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 24px;
    box-shadow: 0 14px 32px rgba(11, 35, 65, 0.05);
  }

  .panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .panel-heading h2,
  .ai-extract h2 {
    margin: 0;
    color: var(--color-navy);
    font-size: 1.35rem;
  }

  .panel-heading a {
    color: var(--color-steel);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .home-faq-list,
  .home-news-list {
    display: grid;
    gap: 12px;
  }

  .home-faq-list article,
  .home-news-list article {
    padding: 14px 0;
    border-top: 1px solid var(--color-line);
  }

  .home-faq-list article:first-child,
  .home-news-list article:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .home-faq-list h3,
  .home-news-list h3 {
    margin: 0 0 6px;
    color: var(--color-navy);
    font-size: 1rem;
  }

  .home-faq-list p,
  .home-news-list p,
  .ai-extract p {
    margin: 0;
    color: var(--color-steel);
  }

  .home-news-list time {
    display: block;
    color: var(--color-steel);
    font-size: 0.84rem;
    margin-bottom: 4px;
  }

  .home-news-list a:hover {
    color: var(--color-accent);
  }

  .ai-extract {
    grid-column: 1 / -1;
    border-left: 4px solid var(--color-accent);
  }

  .ai-extract p + p {
    margin-top: 10px;
  }

  @media (max-width: 980px) {
    .home-hero {
      min-height: 560px;
    }

    .home-hero::before {
      background: linear-gradient(90deg, rgba(246, 248, 251, 0.98), rgba(246, 248, 251, 0.9));
    }

    .home-hero h1 {
      font-size: 2.35rem;
    }

    .model-feature-row,
    .model-grid,
    .faq-news-grid {
      grid-template-columns: 1fr;
    }

    .service-strip-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .process-flow,
    .why-grid {
      grid-template-columns: 1fr;
    }

    .process-step:not(:last-child)::after {
      display: none;
    }

    .why-item {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .why-item:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 560px) {
    .home-hero {
      min-height: auto;
    }

    .home-hero-inner {
      padding: 58px 0;
    }

    .home-hero h1 {
      font-size: 2rem;
    }

    .home-hero-copy > p:not(.hero-kicker) {
      font-size: 1rem;
    }

    .service-panel {
      padding: 28px 20px;
    }

    .service-strip-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
