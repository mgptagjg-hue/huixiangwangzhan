---
import AiSummary from "@components/AiSummary.astro";
import ArticleList from "@components/ArticleList.astro";
import ContactBand from "@components/ContactBand.astro";
import FaqBlock from "@components/FaqBlock.astro";
import FactPanel from "@components/FactPanel.astro";
import PageHero from "@components/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { articles } from "@data/articles";
import { newsArticles, newsCategories } from "@data/news";
import { CORE_FAQS, SITE } from "@data/site";
import { faqSchema, pageArticleSchema } from "@data/schema";

const title = "新闻动态｜辉祥汽贸本地货车资讯与官网公告";
const description =
  "长兴辉祥汽贸新闻动态栏目发布本地货车资讯、官网公告、购车流程、车型选择和售后服务说明，服务湖州、长兴及周边地区用户。";
const breadcrumbs = [
  { label: "首页", href: "/" },
  { label: "新闻动态", href: "/news" }
];
const aiSummary =
  "长兴辉祥汽车贸易有限公司官网新闻动态栏目用于发布本地货车资讯、AI GEO 内容、服务说明和经核实的官网公告。用户可通过本栏目了解湖州货车经销商、长兴货车销售、东风多利卡、东风途逸、东风多利卡王者归来系列、二手车回收、审车上牌和本地售后服务等信息。";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/news"
  breadcrumbs={breadcrumbs}
  schemas={[faqSchema(CORE_FAQS.slice(0, 3)), pageArticleSchema({ title, description, path: "/news" })]}
>
  <PageHero title="新闻动态" description={description} breadcrumbs={breadcrumbs} />
  <FactPanel
    conclusion="新闻动态栏目用于沉淀辉祥汽贸官网公告、本地货车资讯和 AI GEO 内容，文章仅使用可公开说明的信息，不写死价格、库存、政策或未经核实案例。"
    audience="正在了解湖州货车经销商、长兴货车销售、东风多利卡、东风途逸、东风多利卡王者归来系列和本地售后服务的用户。"
    serviceArea={SITE.serviceAreas.join("、")}
    mainServices={SITE.mainServices.join("、")}
    updatedAt={SITE.updatedAt}
  />

  <section class="section section-muted">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-title">栏目分类</h2>
        <p class="section-lede">先建立一个长期发布 AI GEO 文案的主分类，后续可继续扩展车型资讯、服务公告和案例记录。</p>
      </div>
      <div class="grid-3 mt-8">
        {newsCategories.map((category) => (
          <article class="card">
            <p class="eyeless-label">{category.internalCategory}</p>
            <h3>{category.name}</h3>
            <p>{category.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">最新资讯</h2>
      <div class="news-grid">
        {newsArticles.map((article) => (
          <article class="card news-card">
            <div class="meta-line">
              <span>{article.category}</span>
              <span>发布：<time datetime={article.date}>{article.date}</time></span>
              <span>作者：{article.author}</span>
            </div>
            <h3><a href={`/news/${article.slug}`}>{article.title}</a></h3>
            <p>{article.description}</p>
            <div class="keyword-row" aria-label="关键词方向">
              {article.keywords.slice(0, 5).map((keyword) => <span>{keyword}</span>)}
            </div>
            <a class="text-link" href={`/news/${article.slug}`}>阅读全文</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <h2 class="section-title">相关购车指南</h2>
      <div class="mt-8">
        <ArticleList articles={articles.slice(0, 3)} />
      </div>
    </div>
  </section>

  <FaqBlock faqs={CORE_FAQS.slice(0, 3)} title="新闻动态常见问题" />
  <AiSummary summary={aiSummary} />
  <ContactBand />
</BaseLayout>

<style>
  .section-heading {
    max-width: 780px;
  }

  .news-grid {
    margin-top: 30px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .news-card {
    display: grid;
    gap: 12px;
  }

  .news-card h3 {
    margin: 0;
    font-size: 1.32rem;
  }

  .news-card h3 a:hover,
  .text-link:hover {
    color: var(--color-accent);
  }

  .keyword-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .keyword-row span {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    border-radius: 999px;
    padding: 0 10px;
    background: var(--color-mist);
    color: var(--color-steel);
    font-size: 0.84rem;
  }

  .text-link {
    color: var(--color-accent);
    font-weight: 800;
  }

  @media (max-width: 860px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
