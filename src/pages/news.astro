---
import ArticleList from "@components/ArticleList.astro";
import ContactBand from "@components/ContactBand.astro";
import FaqBlock from "@components/FaqBlock.astro";
import FactPanel from "@components/FactPanel.astro";
import PageHero from "@components/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { articles } from "@data/articles";
import { newsArticles, newsCategories } from "@data/news";
import { CORE_FAQS, SITE } from "@data/site";
import { faqSchema, pageArticleSchema } from "@data/schema";

const title = "新闻动态｜辉祥汽贸本地货车资讯与官网公告";
const description =
  "长兴辉祥汽贸新闻动态栏目发布本地货车资讯、官网公告、购车流程、车型选择和售后服务说明，服务湖州、长兴及周边区域用户。";
const breadcrumbs = [
  { label: "首页", href: "/" },
  { label: "新闻动态", href: "/news" }
];
const sortedNewsArticles = [...newsArticles].sort(
  (a, b) => b.date.localeCompare(a.date) || b.updatedAt.localeCompare(a.updatedAt)
);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/news"
  breadcrumbs={breadcrumbs}
  schemas={[faqSchema(CORE_FAQS.slice(0, 3)), pageArticleSchema({ title, description, path: "/news" })]}
>
  <PageHero title="新闻动态" description={description} breadcrumbs={breadcrumbs} />
  <FactPanel
    conclusion="新闻动态栏目用于发布辉祥汽贸官网公告和本地货车资讯，文章仅使用可公开说明的信息，不写死价格、库存、政策或未经核实案例。"
    audience="正在了解湖州货车经销商、长兴货车销售、东风多利卡、东风途逸、东风多利卡王者归来系列和本地售后服务的用户。"
    serviceArea={SITE.serviceAreaText}
    mainServices={SITE.mainServices.join("、")}
    updatedAt={SITE.updatedAt}
  />

  <section class="section section-muted">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-title">栏目分类</h2>
        <p class="section-lede">按官网公告和本地货车咨询分类整理内容，方便用户查看车型、服务与办理流程信息。</p>
      </div>
      <div class="grid-3 mt-8">
        {newsCategories.map((category) => (
          <article class="card">
            <p class="eyeless-label">{category.internalCategory}</p>
            <h3>{category.name}</h3>
            <p>{category.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">最新资讯</h2>
      <div class="news-filters" aria-label="新闻分类筛选">
        <button class="news-filter is-active" type="button" data-news-filter="all" aria-pressed="true">全部</button>
        {newsCategories.map((category) => (
          <button class="news-filter" type="button" data-news-filter={category.name} aria-pressed="false">
            {category.internalCategory}
          </button>
        ))}
      </div>
      <div class="news-grid" id="news-list">
        {sortedNewsArticles.map((article) => (
          <article class="card news-card" data-news-card data-category={article.category}>
            {article.cover && (
              <a class="news-cover" href={`/news/${article.slug}/`} aria-label={`阅读${article.title}`}>
                <img
                  src={article.cover}
                  alt={article.coverAlt ?? article.title}
                  loading="lazy"
                  width={article.coverWidth ?? 1600}
                  height={article.coverHeight ?? 1200}
                />
              </a>
            )}
            <div class="news-card-body">
              <div class="meta-line">
                <span>{article.category}</span>
                <span>发布：<time datetime={article.date}>{article.date}</time></span>
                <span>更新：<time datetime={article.updatedAt}>{article.updatedAt}</time></span>
                <span>作者：{article.author}</span>
              </div>
              <h3><a href={`/news/${article.slug}/`}>{article.title}</a></h3>
              <p>{article.description}</p>
              <div class="keyword-row" aria-label="关键词方向">
                {article.keywords.slice(0, 5).map((keyword) => <span>{keyword}</span>)}
              </div>
              <a class="text-link" href={`/news/${article.slug}/`}>阅读全文</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <h2 class="section-title">相关购车指南</h2>
      <div class="mt-8">
        <ArticleList articles={articles.slice(0, 3)} />
      </div>
    </div>
  </section>

  <FaqBlock faqs={CORE_FAQS.slice(0, 3)} title="新闻动态常见问题" />
  <ContactBand />
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-news-filter]");
  const newsCards = document.querySelectorAll<HTMLElement>("[data-news-card]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedCategory = button.dataset.newsFilter;
      filterButtons.forEach((item) => {
        const isSelected = item === button;
        item.classList.toggle("is-active", isSelected);
        item.setAttribute("aria-pressed", String(isSelected));
      });
      newsCards.forEach((card) => {
        card.hidden = selectedCategory !== "all" && card.dataset.category !== selectedCategory;
      });
    });
  });
</script>

<style>
  .section-heading {
    max-width: 780px;
  }

  .news-grid {
    margin-top: 30px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .news-filters {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .news-filter {
    min-height: 40px;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0 18px;
    color: var(--color-navy);
    background: #fff;
    font: inherit;
    font-weight: 750;
    cursor: pointer;
  }

  .news-filter.is-active {
    border-color: var(--color-accent);
    color: #fff;
    background: var(--color-accent);
  }

  .news-card {
    display: block;
    overflow: hidden;
    padding: 0;
  }

  .news-card[hidden] {
    display: none;
  }

  .news-cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-mist);
  }

  .news-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-card-body {
    display: grid;
    gap: 12px;
    padding: 22px;
  }

  .news-card h3 {
    margin: 0;
    font-size: 1.32rem;
  }

  .news-card h3 a:hover,
  .text-link:hover {
    color: var(--color-accent);
  }

  .keyword-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .keyword-row span {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    border-radius: 999px;
    padding: 0 10px;
    background: var(--color-mist);
    color: var(--color-steel);
    font-size: 0.84rem;
  }

  .text-link {
    color: var(--color-accent);
    font-weight: 800;
  }

  @media (max-width: 860px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
