---
import { NAV_ITEMS, SITE } from "@data/site";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="top-info-bar">
    <div class="header-container top-info-inner">
      <span>湖州 · 长兴｜东风商用车及多品牌合作服务商</span>
      <span>营业时间：{SITE.contact.businessHours}</span>
    </div>
  </div>
  <div class="main-nav-wrap">
    <div class="header-container main-nav-inner">
      <a class="brand" href="/" aria-label={`${SITE.name}首页`}>
        <img class="brand-logo" src="/logo-huixiang.png" alt="辉祥 Logo" width="96" height="48" />
        <span class="brand-copy">
          <strong>{SITE.name}</strong>
          <small>东风商用车 · 长兴地区专业服务商</small>
        </span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {NAV_ITEMS.map((item) => {
          const isActive = item.href === "/" ? pathname === "/" : pathname.startsWith(item.href.split("#")[0]);
          return <a class:list={{ active: isActive }} href={item.href}>{item.label}</a>;
        })}
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: #fff;
    box-shadow: 0 1px 0 rgba(11, 35, 65, 0.08);
  }

  .header-container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .top-info-bar {
    background: #071b33;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .top-info-inner {
    min-height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .main-nav-wrap {
    background: rgba(255, 255, 255, 0.98);
  }

  .main-nav-inner {
    min-height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-width: 330px;
  }

  .brand-logo {
    width: 70px;
    height: 48px;
    object-fit: contain;
    object-position: left center;
  }

  .brand-copy {
    display: grid;
    gap: 3px;
  }

  .brand strong {
    color: var(--color-ink);
    font-size: 1.08rem;
    line-height: 1.2;
    font-weight: 850;
  }

  .brand small {
    color: var(--color-steel);
    font-size: 0.82rem;
    line-height: 1.25;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px 22px;
  }

  .site-nav a {
    position: relative;
    color: #24344a;
    font-size: 0.94rem;
    font-weight: 700;
    padding: 30px 0 28px;
  }

  .site-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a.active {
    color: var(--color-accent);
  }

  .site-nav a:hover::after,
  .site-nav a.active::after {
    transform: scaleX(1);
  }

  @media (max-width: 1060px) {
    .main-nav-inner {
      min-height: auto;
      padding: 16px 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .brand {
      min-width: 0;
    }

    .site-nav {
      width: 100%;
      justify-content: flex-start;
      gap: 8px 18px;
    }

    .site-nav a {
      padding: 4px 0 8px;
    }

    .site-nav a::after {
      bottom: 0;
    }
  }

  @media (max-width: 560px) {
    .header-container {
      width: min(100% - 28px, 1180px);
    }

    .top-info-inner {
      min-height: auto;
      padding: 8px 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
      font-size: 0.78rem;
    }

    .brand {
      gap: 10px;
    }

    .brand-logo {
      width: 58px;
      height: 40px;
    }

    .brand strong {
      font-size: 0.96rem;
    }

    .brand small,
    .site-nav a {
      font-size: 0.8rem;
    }
  }
</style>
