---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@data/site";
import { canonicalPageUrl } from "../../site-origin.mjs";
import {
  breadcrumbSchema,
  organizationSchema,
  siteNavigationSchema,
  websiteSchema
} from "@data/schema";
import "../styles/global.css";

type Crumb = { label: string; href: string };

const {
  title,
  description,
  canonicalPath,
  breadcrumbs = [],
  schemas = [],
  ogType = "website",
  ogImage = "/images/vehicles/hero-3d-truck.png",
  ogImageAlt = "长兴辉祥汽贸商用车展示",
  updatedAt = SITE.updatedAt,
  publishedAt,
  author,
  noIndex = false
} = Astro.props as {
  title: string;
  description: string;
  canonicalPath: string;
  breadcrumbs?: Crumb[];
  schemas?: Record<string, unknown>[];
  ogType?: "website" | "article";
  ogImage?: string | null;
  ogImageAlt?: string;
  updatedAt?: string;
  publishedAt?: string;
  author?: string;
  noIndex?: boolean;
};

const canonicalUrl = canonicalPageUrl(canonicalPath);
const ogImageUrl = ogImage ? new URL(ogImage, SITE.url).toString() : null;
const allSchemas = [
  organizationSchema(),
  websiteSchema(),
  siteNavigationSchema(),
  ...(breadcrumbs.length ? [breadcrumbSchema(breadcrumbs)] : []),
  ...schemas
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={'<meta name="baidu-site-verification" content="codeva-WvxQBXoXv6" />'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noIndex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={`${SITE.name}官网`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogType === "article" && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {ogType === "article" && <meta property="article:modified_time" content={updatedAt} />}
    {ogType === "article" && author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="last-modified" content={updatedAt} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title={`${SITE.name}文本索引`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <Fragment set:html={`<script>
(function(){
var el = document.createElement("script");
el.src = "https://lf1-cdn-tos.bytegoofy.com/goofy/ttzz/push.js?6333db47b94f0b0dd6f60e284337c2d762189f322152e09641a27daf1c3e2123bc434964556b7d7129e9b750ed197d397efd7b0c6c715c1701396e1af40cec962b8d7c8c6655c9b00211740aa8a98e2e";
el.id = "ttzz";
var s = document.getElementsByTagName("script")[0];
s.parentNode.insertBefore(el, s);
})(window)
</script>`} />
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main id="main" class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
