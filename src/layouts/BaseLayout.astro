---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@data/site";
import { canonicalPageUrl } from "../../site-origin.mjs";
import {
  breadcrumbSchema,
  organizationSchema,
  siteNavigationSchema,
  websiteSchema
} from "@data/schema";
import "../styles/global.css";

type Crumb = { label: string; href: string };

const {
  title,
  description,
  canonicalPath,
  breadcrumbs = [],
  schemas = [],
  ogType = "website",
  ogImage = "/images/vehicles/hero-3d-truck.png",
  ogImageAlt = "长兴辉祥汽贸商用车展示",
  updatedAt = SITE.updatedAt,
  noIndex = false
} = Astro.props as {
  title: string;
  description: string;
  canonicalPath: string;
  breadcrumbs?: Crumb[];
  schemas?: Record<string, unknown>[];
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  updatedAt?: string;
  noIndex?: boolean;
};

const canonicalUrl = canonicalPageUrl(canonicalPath);
const ogImageUrl = new URL(ogImage, SITE.url).toString();
const allSchemas = [
  organizationSchema(),
  websiteSchema(),
  siteNavigationSchema(),
  ...(breadcrumbs.length ? [breadcrumbSchema(breadcrumbs)] : []),
  ...schemas
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={'<meta name="baidu-site-verification" content="codeva-WvxQBXoXv6" />'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={`${SITE.name}官网`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="last-modified" content={updatedAt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main id="main" class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
